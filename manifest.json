{
  "manifest_version": 3,
  "name": "学习公社助手",
  "version": "1.6",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["*://study.enaea.edu.cn/*"],
  "content_scripts": [
    {
      "matches": ["*://study.enaea.edu.cn/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}